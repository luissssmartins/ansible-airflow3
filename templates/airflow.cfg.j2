[core]
dags_folder = {{ airflow_home }}/dags
plugins_folder = {{ airflow_home }}/plugins
executor = LocalExecutor
auth_manager = airflow.providers.fab.auth_manager.fab_auth_manager.FabAuthManager
load_examples = {{ airflow_load_examples }}
execution_api_server_url = http://localhost:{{ airflow_port }}/execution/

[database]
sql_alchemy_conn = postgresql+psycopg2://{{ airflow_db_user }}:{{ airflow_db_password | urlencode }}@localhost:5432/{{ airflow_db_name }}

[logging]
base_log_folder = {{ airflow_home }}/logs

[api]
host = 0.0.0.0
port = {{ airflow_port }}
secret_key = {{ airflow_secret_key }}

[api_auth]
jwt_secret = {{ airflow_jwt_secret }}
