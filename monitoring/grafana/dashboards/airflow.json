{
  "uid": "airflow",
  "title": "Airflow",
  "tags": [
    "airflow",
    "zabbix"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "schemaVersion": 41,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Status das DAGs",
      "datasource": {
        "type": "alexanderzobnin-zabbix-datasource",
        "uid": "zabbix"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "alexanderzobnin-zabbix-datasource",
            "uid": "zabbix"
          },
          "queryType": "0",
          "group": {
            "filter": "/.*/"
          },
          "host": {
            "filter": "/.*/"
          },
          "application": {
            "filter": ""
          },
          "itemTag": {
            "filter": ""
          },
          "item": {
            "filter": "/: status$/"
          },
          "functions": [],
          "options": {
            "showDisabledItems": false
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Falha",
                  "color": "red"
                },
                "1": {
                  "text": "Sucesso",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Duração das execuções",
      "datasource": {
        "type": "alexanderzobnin-zabbix-datasource",
        "uid": "zabbix"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "alexanderzobnin-zabbix-datasource",
            "uid": "zabbix"
          },
          "queryType": "0",
          "group": {
            "filter": "/.*/"
          },
          "host": {
            "filter": "/.*/"
          },
          "application": {
            "filter": ""
          },
          "itemTag": {
            "filter": ""
          },
          "item": {
            "filter": "/: duração$/"
          },
          "functions": [],
          "options": {
            "showDisabledItems": false
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "points",
            "pointSize": 6
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Falhas de tasks",
      "datasource": {
        "type": "alexanderzobnin-zabbix-datasource",
        "uid": "zabbix"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "alexanderzobnin-zabbix-datasource",
            "uid": "zabbix"
          },
          "queryType": "2",
          "group": {
            "filter": "/.*/"
          },
          "host": {
            "filter": "/.*/"
          },
          "application": {
            "filter": ""
          },
          "itemTag": {
            "filter": ""
          },
          "item": {
            "filter": "/: última falha de task$/"
          },
          "functions": [],
          "options": {
            "showDisabledItems": false
          }
        }
      ]
    }
  ]
}